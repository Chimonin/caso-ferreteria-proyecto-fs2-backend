# Copia este archivo como .env y pon la clave que quieras para el MySQL de Docker
# El archivo .env NO se sube a GitHub (esta en el .gitignore)
DB_PASSWORD=
# Genera una clave con: openssl rand -base64 32
JWT_SECRET=
# Otra clave distinta, para las llamadas entre microservicios (mínimo 32 caracteres)
INTERNAL_API_KEY=

# Solo para docker-compose.prod.yml (servidor de AWS)
# La direccion de tu registro de ECR: <numero-de-cuenta>.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRO=
# Donde quede publicado el frontend (para CORS). Si no la pones, usa http://localhost:5173
FRONTEND_URL=
